# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# --- Required ---
# Anthropic API key for the agent loop and evals.
ANTHROPIC_API_KEY=sk-ant-...

# --- Optional integrations ---
# Addgene API token (higher rate limits / private records). Public scraping
# works without it.
ADDGENE_API_TOKEN=

# Email used for NCBI Entrez requests (NCBI asks callers to identify themselves).
NCBI_EMAIL=you@example.org
# Optional NCBI API key for higher Entrez rate limits.
NCBI_API_KEY=

# Email for Unpaywall open-access full-text lookups (required by their API).
UNPAYWALL_EMAIL=you@example.org

# Set to "1" to enable the PubMed integration.
PLASMID_ENABLE_PUBMED=

# Benchling subdomain for BYOL/Benchling integration (e.g. "myorg").
BENCHLING_SUBDOMAIN=

# --- Local overrides ---
# Absolute path to a Bring-Your-Own-Library directory of GenBank files.
PLASMID_USER_LIBRARY=

# Port for the web UI (app/app.py). Defaults to the app's built-in value.
PORT=
